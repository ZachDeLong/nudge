<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- "Go to" in a finished message asks the session's terminal (Terminal,
         iTerm2, Ghostty) to show its tab. The hardened runtime blocks Apple
         Events without this; macOS still asks the user once. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
