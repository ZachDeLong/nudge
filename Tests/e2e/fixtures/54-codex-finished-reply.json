{
  "description": "Codex finishes while you're in another app: a reply from Nudge keeps it going (Stop answered with block + your reply)",
  "patterns": [],
  "hook": "nudge-agent-hook",
  "args": [
    "--agent",
    "codex"
  ],
  "env": {
    "NUDGE_TEST_FRONTMOST": "com.google.Chrome"
  },
  "payload": {
    "session_id": "01a0e0aa-1111-7db0-a373-2832df895844",
    "turn_id": "01a0e0aa-2222-7f73-86ec-073a3d020b44",
    "transcript_path": null,
    "cwd": "/Users/dev/code/api",
    "hook_event_name": "Stop",
    "model": "gpt-6-luna",
    "permission_mode": "default",
    "stop_hook_active": false,
    "last_assistant_message": "Renamed listUsers to getUsers in 2 files."
  },
  "expectPrompt": {
    "kind": "finished",
    "tool": "Stop",
    "agent": "codex",
    "cwd": "/Users/dev/code/api",
    "sessionId": "01a0e0aa-1111-7db0-a373-2832df895844",
    "command": "Renamed listUsers to getUsers in 2 files.",
    "event": "Stop"
  },
  "respond": "text",
  "replyText": "now run the tests",
  "expectStdout": {
    "decision": "block",
    "reason": "The user replied from Nudge: now run the tests"
  },
  "expectExit": 0
}
